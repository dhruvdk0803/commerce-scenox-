# Scenox Commerce — environment
#
# Every form (Get Started, Send 10 Products, Contact) posts to /api/lead.
# Each submission is logged server-side and, when configured, emailed to you
# with the visitor's address as Reply-To and any sample file attached.
# Pick ONE email option. Both can coexist with the webhook.

# --- Option A: your Google Workspace mailbox over SMTP (no DNS changes) ---
#   1. In the Workspace account that will send (e.g. commerce@scenoxstudios.com),
#      turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords  (name it "Scenox website")
#   3. Paste the 16-character password below. Never commit .env.local.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=commerce@scenoxstudios.com
SMTP_PASS=
LEAD_TO_EMAIL=commerce@scenoxstudios.com
LEAD_FROM_EMAIL="Scenox Commerce <commerce@scenoxstudios.com>"

# --- Option B: Resend on a SUBDOMAIN (does not touch Workspace mail) ---
#   Add notify.scenoxstudios.com as the sending domain in resend.com; its
#   SPF/DKIM records live only on that subdomain. Leave SMTP_HOST empty.
RESEND_API_KEY=
# LEAD_FROM_EMAIL="Scenox Commerce <leads@notify.scenoxstudios.com>"

# --- Webhook (optional, runs alongside email) -------------------------
# Forward the raw JSON to a CRM, Zapier, Make, Slack or Google Sheets.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# --- Analytics (client) ----------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
